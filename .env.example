# Intraday App — environment template.
# Copy to .env (never commit .env). Placeholders only; no real secrets here.
# Local runs outside Docker: put overrides (e.g. localhost database URLs) in
# .env.local, which is read after .env. Both files are git-ignored.
# See docs/design/06-configuration-model.md §2.

# ---- Safety -------------------------------------------------------------
# The engine refuses to trade unless this is exactly PAPER.
TRADING_MODE=PAPER
# Must be the Alpaca PAPER endpoint, or the engine refuses to trade.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- Alpaca (engine container only; paper keys) --------------------------
ALPACA_API_KEY_ID=PK_PLACEHOLDER
ALPACA_API_SECRET_KEY=CHANGE_ME
ALPACA_DATA_FEED_DEFAULT=iex
# Plan limits (free/Basic plan: 30 streamed symbols, 200 API calls/min).
ALPACA_STREAM_SYMBOL_LIMIT=30
ALPACA_DATA_RATE_LIMIT=200
ALPACA_TRADING_RATE_LIMIT=200

# ---- Anthropic (engine container only; optional) -------------------------
# Leave empty to force AI_MODE=OFF.
ANTHROPIC_API_KEY=

# ---- Database ------------------------------------------------------------
POSTGRES_DB=intraday
POSTGRES_USER=intraday_owner
POSTGRES_PASSWORD=CHANGE_ME_owner
INTRADAY_API_DB_PASSWORD=CHANGE_ME_api
INTRADAY_ENGINE_DB_PASSWORD=CHANGE_ME_engine
# Each service gets its own login role (see infrastructure/postgres/init).
DATABASE_URL_OWNER=postgresql+asyncpg://intraday_owner:CHANGE_ME_owner@postgres:5432/intraday
DATABASE_URL_API=postgresql+asyncpg://intraday_api:CHANGE_ME_api@postgres:5432/intraday
DATABASE_URL_ENGINE=postgresql+asyncpg://intraday_engine:CHANGE_ME_engine@postgres:5432/intraday

# ---- Redis ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---- Web / auth ----------------------------------------------------------
# 64+ random characters, e.g.: python -c "import secrets;print(secrets.token_urlsafe(64))"
SESSION_SECRET=CHANGE_ME
PUBLIC_ORIGIN=https://trade.example.com
PUBLIC_DOMAIN=trade.example.com
# Set false only for local http development.
COOKIE_SECURE=true

# ---- Email alerts (engine) -----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# ---- Backups (host scripts: infrastructure/scripts/backup.sh) ------------
BACKUP_DIR=/var/backups/intraday
BACKUP_RETENTION_DAYS=14
# Optional off-site copy, e.g. an rclone remote "b2:intraday-backups" (empty = none).
BACKUP_REMOTE=

# ---- Misc ----------------------------------------------------------------
LOG_LEVEL=INFO
TZ=UTC
